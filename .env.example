# CollabTrust environment ledger (non-secret placeholders).
# Canonical source: docs/07-deployment/environment-configuration.md §2
# Copy to .env and replace placeholder values. Never commit real secrets.

# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL=postgresql://user:pass@localhost:5432/collabtrust

# --- Authentication (see ADR-003; 15m access + 7d refresh) ---
JWT_SECRET=changeme_in_production_256bit_secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- LLM provider (benchmark pending — see docs/DOCUMENTATION_STATUS.md open questions) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=your-llm-provider-api-key
LLM_MODEL_NAME=your-model-id
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.2

# --- Logging ---
LOG_LEVEL=info

# --- Frontend ---
# Full base URL for API requests, including the /api/v1 path prefix, in every environment.
VITE_API_URL=http://localhost:3000/api/v1
